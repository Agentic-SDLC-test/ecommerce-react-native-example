# Required — copy this file to .env and set the URL for your platform.
# Restart Expo after changing (npm start / npm run web).
EXPO_PUBLIC_API_URL=http://localhost:3002

# Optional — set to false to hide the product-page review section, the admin
# dashboard's reviews stat card and option row, and to unregister the admin
# reviews route entirely so the moderation screen has no destination.
# Build-time switch: restart Expo after changing it.
EXPO_PUBLIC_REVIEWS_ENABLED=true

# Optional, mock-server only (not EXPO_PUBLIC_ — it is read by the Node
# process, not the app bundle). Comma-separated order statuses that count as a
# verified purchase. Defaults to pending,shipped,delivered. Set to "delivered"
# to require delivery before a shopper may review. The resolved list is printed
# at boot as [reviews] event=config.
# REVIEWS_VERIFIED_PURCHASE_STATUSES=delivered
