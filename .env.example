# Required — copy this file to .env and set the URL for your platform.
# Restart Expo after changing (npm start / npm run web).
EXPO_PUBLIC_API_URL=http://localhost:3002

# NOTE: every EXPO_PUBLIC_* value is inlined into the client bundle at build
# time, so never put a secret here. These are feature booleans only, and
# changing one needs a rebuild — not a config flip.

# Digital payment (simulated card) at checkout. Default on when unset.
# Set to false to restore cash-on-delivery-only checkout without a code revert.
EXPO_PUBLIC_ENABLE_DIGITAL_PAYMENT=true

# Exposes the Approve/Decline switch on the card payment screen so a decline is
# reachable on demand in a stakeholder preview. Already on in dev builds; leave
# unset (or false) for store builds so shoppers never see a "make it fail" toggle.
EXPO_PUBLIC_PAYMENT_SIM_CONTROLS=false
